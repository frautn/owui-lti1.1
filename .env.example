DJANGO_SECRET_KEY=django_secret_key_here
OPENWEBUI_API_KEY=user_openwebui_API_key
OPENWEBUI_URL=http://localhost:3000 # Must be same domain as Django
OPENWEBUI_TRUSTED_EMAIL_HEADER=X-Forwarded-Email #Leave it as is
OPENWEBUI_TRUSTED_NAME_HEADER=X-Forwarded-Name  #Leave it as is
OPENWEBUI_TRUSTED_ROLE_HEADER=X-Forwarded-Role  #Leave it as is
OPENWEBUI_DEFAULT_MODEL=ejercicio-mec002 #Model id to open the chat with
MOODLE_CONSUMER_KEY=moodle_key
MOODLE_SHARED_SECRET=your_super_secret_moodle_shared_secret
LTI_TRUST_PROXY_HEADERS=False # Use True only behind a trusted reverse proxy that sets X-Forwarded-* headers.
LTI_EXTERNAL_LAUNCH_URL= # Set to exact Moodle Tool URL when Django sees a different internal URL (scheme/host/port/path).
LTI_SIGNATURE_DEBUG=False # Set True temporarily to include URL-normalization hints in signature-failure responses.